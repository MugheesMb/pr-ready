# --- LLM ---
# provider = "anthropic" (needs ANTHROPIC_API_KEY), "google" (needs
# GOOGLE_API_KEY, free tier at aistudio.google.com/apikey, no card needed),
# or "deepseek" (needs DEEPSEEK_API_KEY, cheap but not free — needs a card
# to add credit at platform.deepseek.com)
LLM_PROVIDER=google
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# --- Mode switch ---
# true  = use the local mock schema (src/mock_schema.json), no DataHub needed
# false = talk to a real, running DataHub instance via its MCP Server
USE_MOCK_DATAHUB=true

# --- Only needed once USE_MOCK_DATAHUB=false ---
# Default local quickstart values from `datahub docker quickstart`
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# --- Only needed for the pr_writer node to open a real PR ---
# Leave blank to just write the file locally instead
GITHUB_TOKEN=
GITHUB_REPO=yourusername/pr-ready-demo-repo
